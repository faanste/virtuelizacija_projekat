<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<system.serviceModel>
		<client>
			<endpoint
				name="SensorService"
				address="net.tcp://localhost:4000/SensorService"
				binding="netTcpBinding"
				bindingConfiguration="tcpBinding"
				contract="Common.ISensorService" />
		</client>

		<bindings>
			<netTcpBinding>
				<binding
					name="tcpBinding"
					transferMode="Streamed"
					maxReceivedMessageSize="10485760"
					openTimeout="00:01:00"
					closeTimeout="00:01:00"
					sendTimeout="00:05:00"
					receiveTimeout="00:10:00" />
			</netTcpBinding>
		</bindings>
	</system.serviceModel>
</configuration>